# 参考：https://uepon.hatenadiary.com/entry/2024/07/05/172413

# 必須フィールド
# ライセンスの受託
LICENSE=accept
# DB2インスタンス名
DB2INSTANCE=db2inst1
# DB2インスタンスユーザーのパスワード
DB2INST1_PASSWORD=password

# オプション
# デフォルトのデータベース名
DBNAME=USERDB
BLU=false
ENABLE_ORACLE_COMPATIBILITY=false
UPDATEAVAIL=NO
TO_CREATE_SAMPLEDB=false
REPODB=false
IS_OSXFS=false
PERSISTENT_HOME=true
HADR_ENABLED=false
ETCD_ENDPOINT=
ETCD_USERNAME=
ETCD_PASSWORD=
